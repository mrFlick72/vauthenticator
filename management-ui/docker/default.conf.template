server {
    listen       80;
    listen  [::]:80;
    server_name  _;

    # Resolve the config-manager upstream at request time (not just once at nginx
    # startup) so this container doesn't crash-loop if config-manager's Service DNS
    # isn't resolvable yet when nginx starts, and so it picks up Service IP changes
    # without a restart. Requires NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 so the base image
    # exports NGINX_LOCAL_RESOLVERS from /etc/resolv.conf (the cluster DNS resolver).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/config {
        set $config_manager_upstream ${CONFIG_MANAGER_UPSTREAM};
        proxy_pass $config_manager_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        default_type text/html;
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri.html $uri =404;
    }

    location /secure/admin {
        default_type text/html;
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri.html $uri =404;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
